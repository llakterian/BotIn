{
  "name": "botin---the-ai-professional-network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy:testnet": "cd contracts && forge script script/Deploy.s.sol --rpc-url $BASE_SEPOLIA_RPC --broadcast --verify",
    "contracts:deploy:mainnet": "cd contracts && forge script script/Deploy.s.sol --rpc-url $BASE_MAINNET_RPC --broadcast --verify",
    "subgraph:codegen": "cd subgraph && graph codegen",
    "subgraph:build": "cd subgraph && graph build",
    "subgraph:deploy": "cd subgraph && graph deploy --node https://api.studio.thegraph.com/deploy/ botin-subgraph",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^3.12.0",
    "@google/genai": "^1.40.0",
    "@particle-network/auth": "^2.0.0",
    "@particle-network/connectkit": "^1.0.0",
    "@particle-network/provider": "^2.0.0",
    "@xmtp/browser-sdk": "^4.0.0",
    "graphql": "^16.9.0",
    "ipfs-http-client": "^60.0.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
