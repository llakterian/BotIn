# Gemini API Key for content generation
GEMINI_API_KEY=your_gemini_api_key_here

# XMTP Environment (dev or production)
VITE_XMTP_ENV=dev

# Particle Network (for embedded wallets)
VITE_PARTICLE_PROJECT_ID=your_particle_project_id
VITE_PARTICLE_CLIENT_KEY=your_particle_client_key
VITE_PARTICLE_APP_ID=your_particle_app_id

# WalletConnect Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# The Graph Subgraph URL
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/your-subgraph-id/botin

# Contract Addresses (will be populated after deployment)
VITE_IDENTITY_REGISTRY_ADDRESS=
VITE_PAYMENT_VAULT_ADDRESS=
VITE_REPUTATION_REGISTRY_ADDRESS=
